{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katefrench",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "send_email": [{ "name": "EMAIL" }],
  // Per visitor and per minute; see worker/rate-limit.ts.
  "ratelimits": [
    {
      "name": "SUBMIT_LIMIT",
      "namespace_id": "48101",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "READ_LIMIT",
      "namespace_id": "48102",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "katefrench",
      // Placeholder: nothing on this branch deploys.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // A private preview at katefrench-preview.<account>.workers.dev. Build with CLOUDFLARE_ENV=preview.
  "env": {
    "preview": {
      "name": "katefrench-preview",
      "workers_dev": true,
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "SUBMIT_LIMIT",
          "namespace_id": "48201",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "READ_LIMIT",
          "namespace_id": "48202",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "katefrench-preview",
          "database_id": "84937f3f-d2e2-4a3c-bf66-f244cab46dc8",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
